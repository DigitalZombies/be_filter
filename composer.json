    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "psr/event-dispatcher": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "DigitalZombies\\BeFilter\\": "Classes/"
        }
    },
